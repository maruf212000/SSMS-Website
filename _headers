# Netlify response headers — served from the publish root.

/*
  # --- Enforced (safe) ---
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

  # --- CSP in REPORT-ONLY first ---
  # Watch the browser console / Netlify logs for violations for a week or two,
  # then rename this header to `Content-Security-Policy` to enforce.
  # `'unsafe-inline'` on script/style is required because the site has many
  # inline <script>/<style> blocks; tighten with hashes/nonces if those are
  # ever removed.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'

# Long cache for fingerprint-free static assets is risky (no hashing in this
# build), so keep assets on a short-ish cache with revalidation.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=86400, must-revalidate
